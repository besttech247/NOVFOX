# ==========================================
# Railway Environment Variables
# ==========================================

# Port (Provided automatically by Railway, default: 3001)
PORT=3001

# Admin password for web interface access (Default is 'admin' if unset)
ADMIN_PASSWORD=admin

# Session secret for signing cookies (Optional, will use fallback if not set)
SESSION_SECRET=super-secret-key-change-in-production

# PostgreSQL connection URL (Optional: attach a PostgreSQL plugin on Railway to enable database persistence)
# DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Demo mode (Set to 1 or true to use mock synthetic market data)
DEMO_MODE=false
